# Ignore debug logs generated at runtime
ankiscape_debug.log
ankiscape_debug.log.*

# Python cache
__pycache__/
*.pyc

# macOS and editor noise
.DS_Store
.idea/
.vscode/

# Virtual environments
.venv/
venv/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml

# Anki addon local metadata (created by Anki on install; do not commit)
meta.json

# Build artifacts
*.ankiaddon
dist/
build/

# 3.0 isolated dev runtime (synthetic only; never personal data)
.dev/
artifacts/
.supabase/
.env
.env.local

# Supabase CLI local state (may embed local dev keys)
server/supabase/.branches/
server/supabase/.temp/
**/supabase/.temp/

# Build-time prod endpoint (public anon key only, but per-release generated;
# never committed — rebuild with scripts/make_prod_config.py per release)
evolved/prod_config.py
